# --- Datenbank -------------------------------------------------------
# Pfad zur SQLite-Datei (relativ zum Projekt-Root oder absolut)
DATABASE_URL="file:./data/games.db"

# --- Auth (Single-User) ----------------------------------------------
# Admin-Zugangsdaten legst du normalerweise NICHT hier an, sondern beim ersten
# Öffnen der App unter /setup (Benutzername + Passwort werden dort direkt in
# der DB gespeichert). ADMIN_USER/ADMIN_PASSWORD_HASH unten sind nur ein
# optionaler Fallback für Deployments ohne Node/npx auf dem Zielhost, bei
# denen der Hash lokal (z. B. auf deinem Rechner) vorab erzeugt wird:
#   npx tsx scripts/hash-password.ts "dein-passwort"
# Base64-kodiert, weil die '$'-Trenner im rohen Argon2-Hash sonst von dotenv
# als Variablen-Referenzen fehlinterpretiert werden. Sobald das Konto einmal
# existiert (per /setup oder diesem Fallback), gewinnt immer die DB — diese
# beiden Variablen werden dann ignoriert.
ADMIN_USER=""
ADMIN_PASSWORD_HASH=""

# Zufälliger, langer Zufallsstring zum Signieren der Session-JWTs.
# Erzeugen z. B. mit:
#   openssl rand -base64 48
SESSION_SECRET=""

# --- SteamGridDB (optional) -------------------------------------------
# API-Key aus deinem SteamGridDB-Profil (kostenlos): https://www.steamgriddb.com/profile/preferences/api
# Wird im Admin-Bereich genutzt, um Cover per Game-ID über die offizielle API
# herunterzuladen (statt sie extern zu verlinken).
STEAMGRIDDB_API_KEY=""

# --- SvelteKit / adapter-node -----------------------------------------
# Öffentliche URL, unter der die App erreichbar ist (für Cookie/CSRF-Checks)
ORIGIN="https://games.example.com"

# Port, auf dem der Node-Server lauscht (dahinter läuft dein Reverse Proxy)
PORT=3000
