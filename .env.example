# --- Datenbank -------------------------------------------------------
# Pfad zur SQLite-Datei (relativ zum Projekt-Root oder absolut)
DATABASE_URL="file:./data/games.db"

# --- Auth (Single-User) ----------------------------------------------
# Login-Name für den Admin-Bereich
ADMIN_USER="admin"

# Base64-kodierter Argon2-Hash des Admin-Passworts — NICHT das Klartext-Passwort eintragen.
# Base64, weil die '$'-Trenner im rohen Argon2-Hash sonst von dotenv als
# Variablen-Referenzen fehlinterpretiert werden.
# Erzeugen mit dem im Projekt enthaltenen Script:
#   npx tsx scripts/hash-password.ts "dein-passwort"
# Der Befehl gibt genau den Wert aus, der hier reinkommt.
ADMIN_PASSWORD_HASH=""

# Zufälliger, langer Zufallsstring zum Signieren der Session-JWTs.
# Erzeugen z. B. mit:
#   openssl rand -base64 48
SESSION_SECRET=""

# --- SteamGridDB (optional) -------------------------------------------
# API-Key aus deinem SteamGridDB-Profil (kostenlos): https://www.steamgriddb.com/profile/preferences/api
# Wird im Admin-Bereich genutzt, um Cover per Game-ID über die offizielle API
# herunterzuladen (statt sie extern zu verlinken).
STEAMGRIDDB_API_KEY=""

# --- SvelteKit / adapter-node -----------------------------------------
# Öffentliche URL, unter der die App erreichbar ist (für Cookie/CSRF-Checks)
ORIGIN="https://games.example.com"

# Port, auf dem der Node-Server lauscht (dahinter läuft dein Reverse Proxy)
PORT=3000
